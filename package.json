{
  "name": "fdtd-2d-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Browser-based 2D FDTD teaching and research simulator.",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "serve": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "node scripts/build-pages.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node scripts/validate-typed-selection.mjs && node scripts/validate-static.mjs",
    "validate": "node scripts/validate-static.mjs --json",
    "validate:static": "node scripts/validate-static.mjs",
    "validate:json": "node scripts/validate-static.mjs --json",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "validate:subpixel": "node scripts/validate-subpixel-smoothing.mjs",
    "validate:mode-solver": "node scripts/validate-mode-solver.mjs",
    "validate:scenes": "pnpm build:pages && node scripts/validate-scene-library.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "validate:pages": "node scripts/build-pages.mjs && node scripts/browser-smoke.mjs --root dist",
    "generate:scene-thumbnails": "node scripts/generate-scene-thumbnails.mjs",
    "generate:resonator-thumbnails": "node scripts/generate-resonator-thumbnails.mjs",
    "validate:all": "tsc --noEmit && node scripts/validate-static.mjs && node scripts/validate-architecture.mjs && node scripts/validate-subpixel-smoothing.mjs",
    "validate:runtime": "node scripts/validate-runtime-core.mjs",
    "validate:selection": "node scripts/validate-typed-selection.mjs",
    "validate:physics": "node scripts/browser-physics.mjs",
    "validate:physics:all": "node scripts/browser-smoke.mjs --physics --all",
    "validate:ui": "node scripts/audit-ui.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "audit:scenes": "pnpm build:pages && node scripts/audit-scene-contracts.mjs --write",
    "audit:guides": "node scripts/audit-scene-guides.mjs --write",
    "audit:guides:doi": "node scripts/audit-scene-guides.mjs --write --check-doi",
    "validate:mmi": "node scripts/validate-mmi-split.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:smoke": "node scripts/browser-smoke.mjs",
    "test:browser:physics": "node scripts/browser-physics.mjs",
    "test:browser:physics:all": "node scripts/browser-smoke.mjs --physics --all",
    "test:physics": "node scripts/browser-physics.mjs",
    "benchmark": "node scripts/performance-benchmark.mjs",
    "benchmark:perf": "node scripts/performance-benchmark.mjs",
    "benchmark:render": "node scripts/render-backend-benchmark.mjs",
    "build:wasm:cpp": "powershell -ExecutionPolicy Bypass -File scripts/build-wasm-cpp.ps1",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@carbon/styles": "1.112.0",
    "@ibm/plex": "6.4.1",
    "@storybook/react-vite": "^10.5.7",
    "@types/node": "24.13.3",
    "@types/plotly.js": "^3.0.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "playwright": "^1.62.1",
    "sass": "1.102.0",
    "storybook": "^10.5.7",
    "typescript": "6.0.2",
    "vite": "8.2.0"
  },
  "dependencies": {
    "plotly.js-basic-dist-min": "^3.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
